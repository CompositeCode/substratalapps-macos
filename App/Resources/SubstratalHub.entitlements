<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: an API client. Outgoing network only; files only through the
	     open/save panels (fileImporter / fileExporter). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Added when their prerequisites exist (see docs/PREREQUISITES.md):
	     aps-environment (APNs: needs the app_hub Application and its push credential),
	     com.apple.developer.associated-domains (applinks/webcredentials: needs
	     dashboard.substratalapps.com serving apple-app-site-association). -->
</dict>
</plist>
